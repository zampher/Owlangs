# Flutter (frontend) artifacts - do not commit
# Ensures accidental additions from IDEs or scripts are ignored at repo root
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.pub-cache/
frontend/.pub/
frontend/build/
frontend/.metadata
frontend/coverage/
frontend/**/ios/Flutter/.last_build_id
# Flutter generated plugin registrant (per-platform, regenerated by flutter pub get)
frontend/linux/flutter/generated_plugin_registrant.*
frontend/linux/flutter/generated_plugins.cmake
frontend/macos/Flutter/GeneratedPluginRegistrant.swift
frontend/windows/flutter/generated_plugin_registrant.*
frontend/windows/flutter/generated_plugins.cmake
frontend/android/app/debug
frontend/android/app/profile
frontend/android/app/release

# Flutter web build output copied to backend (do not commit)
backend/static/flutter-web/

# NSIS generated script (build scripts write here, never modify installer.nsi in repo)
tools/build/installer_generated.nsi

# Launcher build artifacts - do not commit
launcher/bin/
launcher/obj/

# TeX Live variable dir (fmtutil-generated formats, logs); keep only xelatex.fmt for instant first PDF export
