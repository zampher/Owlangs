!3rdParty/windows/pdflatex/texmf-var/web2c/
3rdParty/windows/pdflatex/texmf-var/web2c/*
!3rdParty/windows/pdflatex/texmf-var/web2c/xetex/
3rdParty/windows/pdflatex/texmf-var/web2c/xetex/*
!3rdParty/windows/pdflatex/texmf-var/web2c/xetex/xelatex.fmt

