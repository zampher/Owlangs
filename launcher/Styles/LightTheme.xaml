<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light Theme Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TextForegroundBrush" Color="#333333"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666666"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#999999"/>
    
    <!-- Button Colors - Matching Flutter Material Design -->
    <SolidColorBrush x:Key="ButtonPrimaryBrush" Color="#1976D2"/>
    <SolidColorBrush x:Key="ButtonPrimaryHoverBrush" Color="#1565C0"/>
    <SolidColorBrush x:Key="ButtonSecondaryBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ButtonSecondaryHoverBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="ButtonDangerBrush" Color="#B00020"/>
    <SolidColorBrush x:Key="ButtonDangerHoverBrush" Color="#9A001A"/>
    <SolidColorBrush x:Key="ButtonSuccessBrush" Color="#1976D2"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonSecondaryTextBrush" Color="#333333"/>
    
    <!-- Status Colors -->
    <SolidColorBrush x:Key="StatusIndicatorRunningBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="StatusIndicatorStoppedBrush" Color="#F44336"/>
    <SolidColorBrush x:Key="StatusIndicatorWarningBrush" Color="#FF9800"/>
    
    <!-- Log Area Colors -->
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LogTextBrush" Color="#212121"/>
    
    <!-- Status Bar Colors -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#1976D2"/>
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#FFFFFF"/>
</ResourceDictionary>
