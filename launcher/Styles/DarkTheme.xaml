<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark Theme Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#252526"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="TextForegroundBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#999999"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#666666"/>
    
    <!-- Button Colors - Matching Flutter Material Design -->
    <SolidColorBrush x:Key="ButtonPrimaryBrush" Color="#1976D2"/>
    <SolidColorBrush x:Key="ButtonPrimaryHoverBrush" Color="#2196F3"/>
    <SolidColorBrush x:Key="ButtonSecondaryBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="ButtonSecondaryHoverBrush" Color="#4A4A52"/>
    <SolidColorBrush x:Key="ButtonDangerBrush" Color="#CF6679"/>
    <SolidColorBrush x:Key="ButtonDangerHoverBrush" Color="#E57388"/>
    <SolidColorBrush x:Key="ButtonSuccessBrush" Color="#1976D2"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonSecondaryTextBrush" Color="#CCCCCC"/>
    
    <!-- Status Colors -->
    <SolidColorBrush x:Key="StatusIndicatorRunningBrush" Color="#4EC9B0"/>
    <SolidColorBrush x:Key="StatusIndicatorStoppedBrush" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="StatusIndicatorWarningBrush" Color="#CE9178"/>
    
    <!-- Log Area Colors -->
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="LogTextBrush" Color="#D4D4D4"/>
    
    <!-- Status Bar Colors -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#FFFFFF"/>
</ResourceDictionary>
