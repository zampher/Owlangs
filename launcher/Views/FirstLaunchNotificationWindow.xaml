<Window x:Class="OwlangsLauncher.Views.FirstLaunchNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Owlangs" 
        Height="200" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">
    <Border CornerRadius="10" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- App Icon/Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <TextBlock Text="🦉" FontSize="32" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Owlangs" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            
            <!-- Message Text -->
            <TextBlock x:Name="MessageText" 
                       Grid.Row="1" 
                       Text="The application will automatically hide to the system tray. You can find it in the taskbar." 
                       FontSize="13" 
                       Foreground="{DynamicResource TextForegroundBrush}" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       LineHeight="20"/>
        </Grid>
    </Border>
</Window>
