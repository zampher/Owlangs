<Window x:Class="OwlangsLauncher.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Owlangs Console" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Main Action Area - Prominent Start App Button -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" Padding="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- App Title, Hint and Status -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5">
                        <Image Source="/Resources/logo.png" 
                               Width="32" 
                               Height="32" 
                               VerticalAlignment="Center" 
                               Margin="0,0,12,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Owlangs" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Please ensure Server is started before starting App." 
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="MainStatusIndicator" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush x:Name="MainStatusBrush"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="MainStatusText" Text="Ready to start" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Primary Action Buttons (moved to left panel) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Server Control -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Title -->
                    <TextBlock Grid.Row="0" Text="Server Control" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextForegroundBrush}" Margin="0,0,0,15"/>

                    <!-- Backend Status and Control -->
                    <Border Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" Padding="12" Margin="0,0,0,10" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Row 0: Status (left) + Checkbox (right) -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Ellipse x:Name="BackendStatusIndicator" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush x:Name="BackendStatusBrush"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel>
                                        <TextBlock x:Name="BackendStatusText" Text="Server" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextForegroundBrush}"/>
                                        <TextBlock x:Name="BackendStatusDetail" Text="Port: 8800" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox x:Name="BackendAutoStartCheckBox" Grid.Column="1"
                                          IsChecked="True" VerticalAlignment="Center"
                                          Checked="BackendAutoStartCheckBox_Changed"
                                          Unchecked="BackendAutoStartCheckBox_Changed">
                                    <TextBlock Text="Auto-start" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </CheckBox>
                            </Grid>
                            <!-- Row 1: Buttons -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="BackendStartButton" Content="Start" Click="BackendStartButton_Click"
                                        Margin="3,0" Padding="12,6" Style="{StaticResource PrimaryButtonStyle}"
                                        FontSize="11" MinWidth="70"/>
                                <Button x:Name="BackendStopButton" Content="Stop" Click="BackendStopButton_Click"
                                        Margin="3,0" Padding="12,6" Style="{StaticResource DangerButtonStyle}"
                                        FontSize="11" MinWidth="70" IsEnabled="False"/>
                                <Button x:Name="BackendRestartButton" Content="Restart" Click="BackendRestartButton_Click"
                                        Margin="3,0" Padding="12,6" Style="{StaticResource PrimaryButtonStyle}"
                                        FontSize="11" MinWidth="70" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Frontend Status and Control -->
                    <Border Grid.Row="2" Background="{DynamicResource WindowBackgroundBrush}" Padding="12" Margin="0,0,0,10" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Row 0: Status (left) + Checkbox (right) -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Ellipse x:Name="FrontendStatusIndicator" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush x:Name="FrontendStatusBrush"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel>
                                        <TextBlock x:Name="FrontendStatusText" Text="App" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextForegroundBrush}"/>
                                        <TextBlock x:Name="FrontendStatusDetail" Text="Not running" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox x:Name="FrontendAutoStartCheckBox" Grid.Column="1"
                                          IsChecked="True" VerticalAlignment="Center"
                                          Checked="FrontendAutoStartCheckBox_Changed"
                                          Unchecked="FrontendAutoStartCheckBox_Changed">
                                    <TextBlock Text="Auto-start" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </CheckBox>
                            </Grid>
                            <!-- Row 1: Buttons -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="FrontendStartButton" Content="Start" Click="FrontendStartButton_Click"
                                        Margin="3,0" Padding="12,6" Style="{StaticResource PrimaryButtonStyle}"
                                        FontSize="11" MinWidth="70"/>
                                <Button x:Name="FrontendStopButton" Content="Stop" Click="FrontendStopButton_Click"
                                        Margin="3,0" Padding="12,6" Style="{StaticResource DangerButtonStyle}"
                                        FontSize="11" MinWidth="70" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Browser Control -->
                    <Border Grid.Row="3" Background="{DynamicResource WindowBackgroundBrush}" Padding="12" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Row 0: Label (left) + Checkbox (right) -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Browser" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="BrowserAutoOpenCheckBox" Grid.Column="1"
                                          IsChecked="True" VerticalAlignment="Center"
                                          Checked="BrowserAutoOpenCheckBox_Changed"
                                          Unchecked="BrowserAutoOpenCheckBox_Changed">
                                    <TextBlock Text="Auto-open" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </CheckBox>
                            </Grid>
                            <!-- Row 1: Button -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="OpenBrowserButton" Content="Open" Click="OpenBrowserButton_Click"
                                        Margin="3,0" Padding="12,6" Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="11" MinWidth="70"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Divider -->
            <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>

            <!-- Right Panel - Logs Area -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Log Header -->
                <Border Grid.Row="0" Background="{DynamicResource WindowBackgroundBrush}" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Logs" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="  ·  Level:" Margin="10,0,4,0" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="11"/>
                            <ComboBox x:Name="LogLevelFilterComboBox"
                                      Width="90"
                                      SelectedIndex="2"
                                      SelectionChanged="LogLevelFilterComboBox_SelectionChanged"
                                      Margin="0,0,0,0"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="Error"/>
                                <ComboBoxItem Content="Warning"/>
                                <ComboBoxItem Content="Info"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Clear" Click="ClearButton_Click"
                                    Margin="3,0" Padding="8,4" Style="{StaticResource SecondaryButtonStyle}"
                                    FontSize="11" MinWidth="60"/>
                            <Button Content="Save" Click="SaveButton_Click"
                                    Margin="3,0" Padding="8,4" Style="{StaticResource SecondaryButtonStyle}"
                                    FontSize="11" MinWidth="60"/>
                            <Button Content="Copy" Click="CopyButton_Click"
                                    Margin="3,0" Padding="8,4" Style="{StaticResource SecondaryButtonStyle}"
                                    FontSize="11" MinWidth="60"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Log Text Area -->
                <ScrollViewer x:Name="LogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource LogBackgroundBrush}">
                    <TextBox x:Name="LogTextBox"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="11"
                             Background="{DynamicResource LogBackgroundBrush}"
                             Foreground="{DynamicResource LogTextBrush}"
                             BorderThickness="0"
                             VerticalScrollBarVisibility="Auto"/>
                </ScrollViewer>
            </Grid>
        </Grid>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="{DynamicResource StatusBarBackgroundBrush}" Foreground="{DynamicResource StatusBarForegroundBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" Margin="5,0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="LogCountText" Text="Lines: 0" Margin="5,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
