<Window x:Class="OwlangsLauncher.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Owlangs" 
        Height="300" Width="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Border CornerRadius="10" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- App Icon/Title (top-left) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,20">
                <Image Source="/Resources/logo.png" 
                       Width="48" 
                       Height="48" 
                       VerticalAlignment="Center" 
                       Margin="0,0,15,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Owlangs" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextForegroundBrush}"/>
                    <TextBlock Text="Starting..." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>
            
            <!-- Status Text -->
            <TextBlock x:Name="StatusText" 
                       Grid.Row="1" 
                       Text="Initializing..." 
                       FontSize="14" 
                       Foreground="{DynamicResource TextForegroundBrush}" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            
            <!-- Progress Bar -->
            <ProgressBar x:Name="ProgressBar" 
                         Grid.Row="2" 
                         Height="8" 
                         Margin="0,20,0,10"
                         Background="{DynamicResource ButtonSecondaryBrush}"
                         Foreground="{DynamicResource ButtonPrimaryBrush}"
                         IsIndeterminate="True"/>
            
            <!-- Version Info -->
            <TextBlock Grid.Row="3" 
                       Text="Version 1.5.6.0" 
                       FontSize="11" 
                       Foreground="{DynamicResource TextTertiaryBrush}" 
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
        </Grid>
    </Border>
</Window>
